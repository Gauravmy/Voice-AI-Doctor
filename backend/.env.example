# Copy to backend/.env and fill in. Never commit .env.

# auto = live voice when both keys below are set, otherwise text-only mock mode
# live = always real pipeline   |   mock = always development mock
VOICE_MODE=auto

# Google Gemini (LLM) - https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-google-ai-studio-key
# Leave empty to use Pipecat's default Gemini model, or pick one your key can use
GEMINI_MODEL=

# ElevenLabs (Speech-to-Text + Text-to-Speech) - https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=your-elevenlabs-key
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
# realtime = streaming STT over WebSocket; batch = one request per utterance
ELEVENLABS_STT_MODE=realtime

# Clinic / app
CLINIC_NAME=Brightwell Family Clinic
CLINIC_TIMEZONE=Asia/Kolkata
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=INFO
